/*
 * TOTEM TEST KEYMAP (Minimal & Clean for ZMK Main / Zephyr 4.1)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define NUM  2
#define SYM  3
#define FUN  4

/ {
    chosen {
        zmk,matrix-transform = &default_transform;
        zmk,physical-layout = &default_layout;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NAV NUM>;
            then-layer = <SYM>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
                &kp Q      &kp W      &kp F      &kp P      &kp B        &kp J      &kp L      &kp U      &kp Y      &kp SQT
                &kp A      &kp R      &kp S      &kp T      &kp G        &kp M      &kp N      &kp E      &kp I      &kp O
    &kp ESC     &kp Z      &kp X      &kp C      &kp D      &kp V        &kp K      &kp H      &kp COMMA  &kp DOT    &kp FSLH  &kp BSPC
                                      &none      &mo NAV    &kp LSHFT    &mo FUN    &lt NUM SPACE &none
            >;
        };

        NAV {
            display-name = "NAV";
            bindings = <
                &kp ESC    &kp TAB    &kp K_APP  &kp GRAVE  &kp TAB      &kp PG_UP  &none      &kp UP     &none      &kp BSPC
                &kp LSHFT  &kp LCTRL  &kp LALT   &kp LGUI   &none        &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp DEL
    &none       &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(Y)  &kp LG(V)    &none      &none      &none      &none      &kp ENTER &none
                                      &trans     &trans     &trans       &trans     &mo NUM    &trans
            >;
        };

        NUM {
            display-name = "NUM";
            bindings = <
                &none      &kp F7     &kp F8     &kp F9     &kp F12      &none      &kp N7     &kp N8     &kp N9     &kp BSPC
                &kp LSHFT  &kp F4     &kp F5     &kp F6     &kp F11      &none      &kp N4     &kp N5     &kp N6     &kp N0
    &none       &none      &kp F1     &kp F2     &kp F3     &kp F10      &kp COLON  &kp N1     &kp N2     &kp N3     &kp DOT   &none
                                      &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        SYM {
            display-name = "SYM";
            bindings = <
                &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT    &kp ASTRK  &kp LPAR   &kp RPAR   &kp MINUS  &kp EQUAL
                &trans     &kp TILDE  &kp PIPE   &kp PLUS   &kp CARET    &kp AMPS   &kp LBKT   &kp RBKT   &kp GRAVE  &kp BSLH
    &none       &none      &trans     &trans     &trans     &trans       &kp UNDER  &kp LBRC   &kp RBRC   &kp COLON  &kp SEMI  &none
                                      &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        FUN {
            display-name = "FUN";
            bindings = <
                &studio_unlock &kp C_PREV &kp C_PP &kp C_NEXT &kp C_VOL_UP   &none  &none        &none        &none        &none
                &none          &none      &none    &none      &kp C_VOL_DN   &none  &none        &none        &none        &none
    &none       &out OUT_TOG   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_CLR &none &none     &none        &none        &none     &none
                                          &trans   &trans     &trans         &trans &trans       &trans
            >;
        };
    };
};
